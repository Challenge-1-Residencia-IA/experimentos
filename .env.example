# Token opcional. Deixe vazio para o Qwen público; nunca versione um token real.
HF_TOKEN=

# Modelo-base usado nos fluxos MLX. Os scripts também aceitam --model.
HF_MODEL_REPO=mlx-community/Qwen2.5-7B-Instruct-4bit

# Usado somente pela amostragem auxiliar via Ollama; não carrega adapters MLX.
OLLAMA_MODEL=qwen2.5:7b

# Banco local compartilhado por treinos, avaliações e verificações.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=sift-lora-fine-tuning

# Remove a mensagem de sugestão do agente do MLflow no terminal.
MLFLOW_DISABLE_AGENT_HINT=1

# Copie este arquivo para .env na raiz do projeto: cp .env.example .env
# O .env é local e não deve ser enviado ao Git. Nunca coloque tokens aqui no
# arquivo .env.example; cada pessoa configura suas credenciais no próprio .env.

# Uso normal da tutora RAG (opção 3): Ollama instalado e modelo baixado com
# `ollama pull qwen2.5:7b`. Não é necessário DagsHub nem chave de API.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434/api/chat

# MLflow local por padrão: mlflow.db e mlartifacts/rag na pasta do projeto.
# A opção 3 pergunta o nome do experimento ao iniciar a conversa.
MLFLOW_EXPERIMENT_NAME=NexoVerdict-RAG
# Opcional: substitua o banco local por uma URI SQLite com caminho absoluto.
# MLFLOW_TRACKING_URI=sqlite:////tmp/nexoverdict-mlflow/mlflow.db

# Somente para publicar/sincronizar no DagsHub. Descomente e preencha no .env
# pessoal; cada colaborador usa suas próprias credenciais. Isto não é exigido
# para rodar o RAG ou salvar consultas no MLflow local.
# DAGSHUB_REPO=organizacao/repositorio
# MLFLOW_TRACKING_USERNAME=seu_usuario_dagshub
# MLFLOW_TRACKING_PASSWORD=seu_token_dagshub

# Somente para a opção 4 (descoberta via Google Fact Check Tools API).
# A opção 3 pesquisa na web sem esta chave.
# FACT_CHECK_API_KEY=sua_chave_da_api
